{
  // Deploy estático (SPA) via `wrangler deploy` — serve o build do Vite em ./dist.
  // A presença deste ficheiro impede o wrangler de arrancar o wizard de setup
  // interativo no CI (que era o que fazia o deploy falhar).
  "name": "c-trip-app",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
